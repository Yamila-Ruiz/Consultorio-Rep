generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cita {
  idCita             Int                @id @default(autoincrement())
  estado             cita_estado        @default(AGENDADA)
  esPrimeraSesion    Boolean            @default(false)
  idPaciente         Int
  idSlot             Int
  idServicio         Int
  servicio           servicio           @relation(fields: [idServicio], references: [idServicio], onUpdate: Restrict, map: "FK_CIta_Servicio")
  paciente           paciente           @relation(fields: [idPaciente], references: [idPaciente], onUpdate: Restrict, map: "FK_Cita_Paciente")
  slotdisponibilidad slotdisponibilidad @relation(fields: [idSlot], references: [idSlot], onUpdate: Restrict, map: "FK_Cita_Slot")
  multa              multa[]
  pago               pago[]

  @@index([idServicio], map: "FK_CIta_Servicio")
  @@index([idPaciente], map: "FK_Cita_Paciente")
  @@index([idSlot], map: "FK_Cita_Slot")
}

model paciente {
  idPaciente         Int       @id @default(autoincrement())
  nombre             String    @db.VarChar(30)
  aPaterno           String    @db.VarChar(30)
  aMaterno           String    @db.VarChar(30)
  edad               Int
  contactoTelefonico String    @db.VarChar(10)
  nombreFacturacion  String    @db.VarChar(50)
  correoFacturacion  String    @db.VarChar(60)
  fechaRegistro      DateTime  @db.Date
  idTerapeuta        Int
  activo             Boolean   @default(true)
  requiereFactura    Boolean   @default(false)
  cita               cita[]
  terapeuta          terapeuta @relation(fields: [idTerapeuta], references: [idTerapeuta], onUpdate: Restrict, map: "FK_Paciente_Terapeuta")

  @@index([idTerapeuta], map: "FK_Paciente_Terapeuta")
}

model pago {
  idPago      Int      @id @default(autoincrement())
  fecha       DateTime @db.Date
  metodo      String   @db.VarChar(30)
  facturacion Boolean  @default(false)
  idCita      Int
  cita        cita     @relation(fields: [idCita], references: [idCita], onUpdate: Restrict, map: "FK_Pago_Cita")

  @@index([idCita], map: "FK_Pago_Cita")
}

model recepcionista {
  idRecepcion        Int     @id @default(autoincrement())
  nombre             String  @db.VarChar(60)
  aPaterno           String  @db.VarChar(60)
  aMaterno           String  @db.VarChar(60)
  contactoTelefonico String  @db.VarChar(10)
  idUsuario          Int     @unique(map: "idUsuario")
  usuario            usuario @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Restrict, map: "FK_Recepcion_Usuario")
}

model servicio {
  idServicio  Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(30)
  descripcion String  @db.VarChar(50)
  activo      Boolean @default(true)
  cita        cita[]
}

model slotdisponibilidad {
  idSlot      Int       @id @default(autoincrement())
  inicio      DateTime  @db.Time(0)
  fin         DateTime  @db.Time(0)
  fecha       DateTime  @db.Date
  estado      Boolean   @default(true)
  idTerapeuta Int
  cita        cita[]
  terapeuta   terapeuta @relation(fields: [idTerapeuta], references: [idTerapeuta], onUpdate: Restrict, map: "FK_Slot_Terapeuta")

  @@index([idTerapeuta], map: "FK_Slot_Terapeuta")
}

model terapeuta {
  idTerapeuta        Int                  @id @default(autoincrement())
  nombre             String               @db.VarChar(60)
  aPaterno           String               @db.VarChar(60)
  aMaterno           String               @db.VarChar(60)
  contactoTelefonico String               @db.VarChar(10)
  especialidad       String               @db.VarChar(30)
  idUsuario          Int                  @unique(map: "idUsuario")
  activo             Boolean              @default(true)
  paciente           paciente[]
  slotdisponibilidad slotdisponibilidad[]
  usuario            usuario              @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Restrict, map: "FK_Terapeuta_Usuario")
}

model usuario {
  idUsuario     Int            @id @default(autoincrement())
  nombreUsuario String         @db.VarChar(50)
  contrasena    String         @db.VarChar(30)
  recepcionista recepcionista?
  terapeuta     terapeuta?
}

model multa {
  idMulta         Int          @id @unique(map: "idMulta") @default(autoincrement())
  idCita          Int
  monto           Decimal      @db.Decimal(10, 2)
  estado          multa_estado @default(PENDIENTE)
  fechaGeneracion DateTime     @db.Date
  fechaPago       DateTime?    @db.Date
  cita            cita         @relation(fields: [idCita], references: [idCita], onUpdate: Restrict, map: "FK_Cita_Multa")

  @@index([idCita], map: "FK_Cita_Multa")
}

enum cita_estado {
  AGENDADA
  CONFIRMADA
  ATENDIDA
  CANCELADA
  INASISTENCIA
}

enum multa_estado {
  PENDIENTE
  PAGADA
  CANCELADA
}